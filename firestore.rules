rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && role in myData().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // ==================================================
    // USERS
    // Cualquiera autenticado puede leer perfiles (se usa para listar
    // entrenadores, vincular deportistas, mostrar nombres/fotos en
    // partidos y scouting). Cada usuario solo puede crear/editar su
    // propio documento, y no puede cambiarse sus propios roles — eso
    // queda reservado a un admin.
    // ==================================================

    match /users/{userId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.roles == resource.data.roles
        )
      );

      allow delete: if isAdmin();

    }

    // ==================================================
    // ATHLETES
    // ==================================================

    match /athletes/{athleteId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.trainerId == request.auth.uid;

      allow update, delete: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid || isAdmin()
      );

    }

    // ==================================================
    // EVALUATIONS
    // Lectura: el entrenador dueño, un admin, o el propio deportista
    // (si su usuario tiene vinculado ese athleteId).
    // ==================================================

    match /evaluations/{evaluationId} {

      allow read: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid ||
        isAdmin() ||
        myData().athleteId == resource.data.athleteId
      );

      allow create: if isSignedIn() &&
        request.resource.data.trainerId == request.auth.uid;

      allow update, delete: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid || isAdmin()
      );

    }

    // ==================================================
    // SCOUTING
    // Solo el entrenador que lo creó (o un admin) puede ver/editar
    // sus reportes de scouting.
    // ==================================================

    match /scouting/{reportId} {

      allow read, update, delete: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.trainerId == request.auth.uid;

    }

    // ==================================================
    // MEDIA (Fotos/Videos)
    // Cualquiera autenticado puede ver; solo admin/entrenador puede
    // crear/editar/borrar.
    // ==================================================

    match /media/{mediaId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        (hasRole('admin') || hasRole('trainer')) &&
        request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if isSignedIn() &&
        (hasRole('admin') || hasRole('trainer'));

    }

    // ==================================================
    // MATCHES
    // El arbitraje/partido en vivo lo puede tocar cualquier usuario
    // autenticado (árbitro, entrenador, admin) — no hay todavía un
    // campo de "dueño" claro en el modelo para restringir más.
    // ==================================================

    match /matches/{matchId} {

      allow read, write: if isSignedIn();

    }

    // ==================================================
    // NOTIFICATIONS
    // Solo el destinatario puede leer/marcar como leída/borrar la
    // suya. La crea quien la origina (ej. un entrenador notificando
    // a un deportista), no necesariamente el destinatario.
    // ==================================================

    match /notifications/{notificationId} {

      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        (hasRole('trainer') || hasRole('admin'));

    }

  }
}
